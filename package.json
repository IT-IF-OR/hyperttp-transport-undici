{
  "name": "@hyperttp/transport-undici",
  "version": "0.2.4",
  "description": "High-performance, extensible HTTP client for undici",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./dist/package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "client",
    "high-performance",
    "undici",
    "fetch"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-undici.git"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.2.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.0",
    "@types/node": "^26.1.1",
    "@vitest/ui": "^4.1.10",
    "chalk": "^5.6.2",
    "oxlint": "^1.74.0",
    "oxfmt": "^0.59.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "publish": "d-publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "undici": "^8.7.0"
  }
}
