{
  "name": "@hyperttp/transport-undici",
  "version": "0.3.0",
  "description": "High-performance, extensible HTTP client for undici",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./dist/package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "client",
    "high-performance",
    "undici",
    "fetch"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-undici.git"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.3.0",
    "hcacher": "^0.2.0",
    "undici": "^8.10.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^7.0.2",
    "vitest": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "tsc && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  }
}
